{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Emscripten and FFmpeg versions in build/build.sh",
      "managerFilePatterns": ["/^build/build\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["FFmpeg/FFmpeg"],
      "extractVersion": "^n(?<version>\\d+\\.\\d+(\\.\\d+)?)$"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
